{
	"name": "@streamient/mobile",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"assets": "node scripts/generate-assets.mjs",
		"play-store-assets": "node scripts/generate-play-store-assets.mjs",
		"dev": "vite --host 0.0.0.0 --port 5176",
		"build": "NODE_ENV=production tsc --noEmit && NODE_ENV=production vite build",
		"preview": "vite preview --host 0.0.0.0 --port 4176",
		"cap:sync": "pnpm assets && capacitor sync",
		"android:release": "bash scripts/android-release-bundle.sh",
		"ios:release": "bash scripts/ios-release-archive.sh",
		"cap:add:ios": "capacitor add ios",
		"cap:add:android": "capacitor add android"
	},
	"dependencies": {
		"@aparajita/capacitor-secure-storage": "^8.0.0",
		"@capacitor/android": "^8.5.0",
		"@capacitor/app": "^8.1.1",
		"@capacitor/browser": "^8.0.4",
		"@capacitor/cli": "^8.5.0",
		"@capacitor/core": "^8.5.0",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/ios": "^8.5.0",
		"@capacitor/network": "^8.0.1",
		"@capgo/capacitor-share-target": "8.0.45",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/material-symbols-outlined": "^5.3.3",
		"@tiptap/react": "^3.30.1",
		"@tiptap/starter-kit": "^3.30.1",
		"dompurify": "^3.4.13",
		"marked": "^18.0.10",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"socket.io-client": "^4.8.3",
		"sweetalert2": "^11.26.25",
		"vite": "^8.2.1"
	},
	"devDependencies": {
		"@types/react": "^18.3.31",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react": "^6.0.5",
		"typescript": "^6.0.3"
	}
}
