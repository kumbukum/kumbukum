template#st-rich-editor-template
	.st-rich-editor-shell
		.st-rich-editor-toolbar(role="toolbar" aria-label="Text formatting")
			.btn-group.btn-group-sm(role="group" aria-label="Headings")
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="heading1" title="Heading 1" aria-label="Heading 1" aria-pressed="false")
					!= icon('textH1')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="heading2" title="Heading 2" aria-label="Heading 2" aria-pressed="false")
					!= icon('textH2')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="heading3" title="Heading 3" aria-label="Heading 3" aria-pressed="false")
					!= icon('textH3')
			.btn-group.btn-group-sm(role="group" aria-label="Inline formatting")
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="bold" title="Bold" aria-label="Bold" aria-pressed="false")
					!= icon('format_bold')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="italic" title="Italic" aria-label="Italic" aria-pressed="false")
					!= icon('format_italic')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="underline" title="Underline" aria-label="Underline" aria-pressed="false")
					!= icon('format_underlined')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="link" title="Link" aria-label="Link" aria-pressed="false")
					!= icon('link')
			.btn-group.btn-group-sm(role="group" aria-label="Block formatting")
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="bulletList" title="Bullet list" aria-label="Bullet list" aria-pressed="false")
					!= icon('listBullets')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="orderedList" title="Numbered list" aria-label="Numbered list" aria-pressed="false")
					!= icon('listNumbers')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="taskList" title="Task list" aria-label="Task list" aria-pressed="false")
					!= icon('checkSquare')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="codeBlock" title="Code block" aria-label="Code block" aria-pressed="false")
					!= icon('codeBlock')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="blockquote" title="Quote" aria-label="Quote" aria-pressed="false")
					!= icon('quote')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="horizontalRule" title="Divider" aria-label="Divider")
					!= icon('remove')
			.btn-group.btn-group-sm(role="group" aria-label="Editing history")
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="undo" title="Undo" aria-label="Undo")
					!= icon('undo')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="redo" title="Redo" aria-label="Redo")
					!= icon('redo')
				button.btn.btn-sm.btn-outline-secondary.st-rich-editor-button(type="button" data-command="clear" title="Clear formatting" aria-label="Clear formatting")
					!= icon('format_clear')
		.st-rich-editor-body
